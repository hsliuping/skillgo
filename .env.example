# SkillGo 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# === 数据库 ===
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=               # 必填，生产环境请使用强密码
MYSQL_DATABASE=skillgo

# === 服务端口 ===
PORT=3100
RUNNER_PORT=3200

# === 安全 ===
JWT_SECRET=                   # 必填，至少 32 位随机字符串，例：openssl rand -hex 32
JWT_EXPIRES_IN=8h             # Token 有效期，默认 8 小时
ALLOWED_ORIGINS=http://localhost:5173,http://skillgo.cn:5173,http://skillgo.cn:3100   # 本地 skillgo.cn 测试时需包含
ADMIN_DEFAULT_PASSWORD=admin123         # 首次启动自动创建管理员的密码，请立即修改！

# === GitHub/Gitee/GitLab Token（用于导入技能仓库，建议设置以避免 API 限流）===
GITHUB_TOKEN=
GITEE_TOKEN=
GITLAB_TOKEN=

# === 执行沙箱 ===
SANDBOX_ENABLED=false           # true 时使用 Docker 沙箱执行（需挂载 docker.sock）
SANDBOX_MEMORY=256m
SANDBOX_CPUS=0.5
SANDBOX_NETWORK=none
SANDBOX_IMAGE_python=python:3.11-slim
SANDBOX_IMAGE_node=node:20-slim
SANDBOX_IMAGE_bash=bash:5

# === 执行限制 ===
RUN_MAX_TIMEOUT_MS=30000        # 技能执行超时时间（毫秒）
RUN_ALLOW_INSTALL=true          # 是否允许安装依赖
RUN_HTTP_ALLOWED_HOSTS=         # HTTP 技能允许访问的目标，留空不限制，逗号分隔

# === 速率限制 ===
REPORT_AUTO_HIDE_THRESHOLD=3    # 举报多少次自动下架技能

# === AI 自动审核（智谱AI，价格便宜、国内稳定）===
ZHIPU_API_KEY=                  # 智谱AI API Key，见 https://open.bigmodel.cn
ZHIPU_MODEL=glm-4-flash          # 模型：glm-4-flash(便宜) / glm-4 / glm-4-plus
ZHIPU_API_URL=                   # 可选，默认 https://open.bigmodel.cn/api/paas/v4/chat/completions
AI_REVIEW_RUN_TIMEOUT_MS=10000   # AI 审核沙箱试跑超时（毫秒）

# === 邮件通知 ===
NOTIFY_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# === MCP 服务（Runner 用）===
MCP_BASE_URL=http://localhost:3100

# === CLI（用户安装技能时）===
SKILLGO_API_BASE=               # 自建时设为你的 API 地址，如 https://skillgo.cn

# === 开发模式 ===
NODE_ENV=development            # development 时错误响应包含详细信息
